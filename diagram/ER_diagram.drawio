        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br/&gt;display_name&lt;br/&gt;full_name&lt;br/&gt;date_of_birth&lt;br/&gt;email (UNIQUE)&lt;br/&gt;phone_number (NULL)&lt;br/&gt;preferred_contact_method&lt;br/&gt;password_hash&lt;br/&gt;role&lt;br/&gt;is_locked&lt;br/&gt;bio (NULL)&lt;br/&gt;created_at" vertex="1">
