# Core app settings
SECRET_KEY=change-me-for-real-deployments
DATABASE_PATH=instance/app.db
UPLOAD_FOLDER=instance/uploads
LEGACY_UPLOAD_FOLDER=static/uploads
APP_HOST=0.0.0.0
APP_PORT=5001
FLASK_DEBUG=true

# Image storage
# Leave S3 values empty for local development. When S3 is configured,
# deployed environments will use S3 for listing images automatically.
S3_BUCKET_NAME=
S3_REGION=
S3_PUBLIC_BASE_URL=

# AI listing draft
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_IMAGE_MAX_DIMENSION=960
